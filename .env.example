APP_NAME="LCCT Maintenance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_maintenance
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Alerts work out of the box by polling every few seconds (config/school.php).
# For INSTANT WebSocket delivery, run: composer require laravel/reverb  then switch to:
# BROADCAST_CONNECTION=reverb
BROADCAST_CONNECTION=log
REVERB_APP_ID=lcct
REVERB_APP_KEY=lcct-local-key
REVERB_APP_SECRET=lcct-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Leave the next 4 lines commented until Reverb is installed:
# VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST="${REVERB_HOST}"
# VITE_REVERB_PORT="${REVERB_PORT}"
# VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Accounts (Phase 2) ------------------------------------------------------
# ALLOW_PUBLIC_REGISTRATION=true opens /register. SCHOOL_EMAIL_FORMAT: domain | student_number
ALLOW_PUBLIC_REGISTRATION=false
SCHOOL_EMAIL_DOMAIN=lcctanauan.edu.ph
SCHOOL_EMAIL_FORMAT=domain

# --- Email (Phase 1) ---------------------------------------------------------
# Local testing: leave MAIL_MAILER=log (emails are written to storage/logs/laravel.log).
# Real emails via Brevo SMTP: set MAIL_MAILER=smtp and fill in the 4 values below.
#   MAIL_USERNAME = the SMTP login shown in Brevo (SMTP & API > SMTP). NOT your Brevo account password.
#   MAIL_PASSWORD = an SMTP key created in Brevo. NEVER commit it; keep it only in your real .env.
#   MAIL_FROM_ADDRESS must be a sender you verified in Brevo (Senders & IP).
# Then run:  php artisan mail:test you@example.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SUPPORT_ADDRESS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
